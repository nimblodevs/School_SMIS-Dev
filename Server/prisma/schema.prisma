// ============================================================
// School Management System — Prisma Schema (PostgreSQL)
// Multi-tenant SaaS: every school's data is isolated via schoolId
//
// v3 — changes applied:
//   [1] LeaveBalance.employeeKey (fixes NULL-unique trap, same as Payslip)
//   [1] Exam @@unique([termId, subjectId, name])
//   [1] CompetencyAssessment: history instead of clobbering (unique dropped,
//       assessedAt added; query latest per (student, subStrand, term))
//   [1] TimetableSlot conflicts: DateTime @db.Time + DB-only generated
//       columns & exclusion constraints — see migrations/manual_constraints.sql
//   [2] All money/score fields: Float -> Decimal
//   [3] Enums: Gender, EnrollmentStatus, ParentRelation, StaffModule
//   [3] Actor IDs are now real FKs to User (markedBy, assessedBy, grantedBy,
//       recordedBy, approvedBy, processedBy)
//   [4] @db.Date on day-granularity dates; PayrollRun.month format enforced
//       via CHECK in migrations/manual_constraints.sql
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// TENANT ROOT
// ------------------------------------------------------------

model School {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique // subdomain / identifier, e.g. "mater-academy"
  mpesaShortcode String?  @unique // Paybill/Till number, used to route C2B callbacks to this school
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  users                 User[]
  teachers              Teacher[]
  staff                 Staff[]
  students              Student[]
  parents               Parent[]
  academicYears         AcademicYear[]
  terms                 Term[]
  classLevels           ClassLevel[]
  streams               Stream[]
  subjects              Subject[]
  enrollments           Enrollment[]
  attendances           Attendance[]
  exams                 Exam[]
  examResults           ExamResult[]
  timetableSlots        TimetableSlot[]
  classSubjects         ClassSubject[]
  learningAreas         LearningArea[]
  strands               Strand[]
  subStrands            SubStrand[]
  competencyAssessments CompetencyAssessment[]
  feeStructures         FeeStructure[]
  invoices              Invoice[]
  payments              Payment[]
  staffModuleAccess     StaffModuleAccess[]
  auditLogs             AuditLog[]
  salaryStructures      SalaryStructure[]
  allowanceTypes        AllowanceType[]
  statutoryDeductions   StatutoryDeduction[]
  statutoryRateConfigs  StatutoryRateConfig[]
  customDeductions      CustomDeduction[]
  payrollRuns           PayrollRun[]
  payslips              Payslip[]
  employmentContracts   EmploymentContract[]
  leaveTypes            LeaveType[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]
  employeeNumbers       EmployeeNumber[]
  bankAccounts          BankAccount[]
  jobGroups             JobGroup[]
  employeeSalaryLoans   EmployeeSalaryLoan[]
  loanRepayments        LoanRepayment[]
  loanProviders         LoanProvider[]
  loanRequests          EmployeeLoanRequest[]
  resignationRecords    ResignationRecord[]
  uploads               FileUpload[]

  @@map("schools")
}

// ------------------------------------------------------------
// AUTH & USERS
// ------------------------------------------------------------

enum Role {
  SUPER_ADMIN // platform-level, not tied to a school
  ADMIN
  MANAGER // school-wide authority, close to ADMIN but excluded from Payroll/salary data
  TEACHER
  STAFF // generic non-teaching staff (registration, admissions, IT, library...) — access scoped per-module via StaffModuleAccess
  STUDENT
  PARENT
  BURSAR
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  phone        String? @unique
  passwordHash String
  role         Role

  // null only for SUPER_ADMIN — every school-scoped user must have one
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher           Teacher?
  student           Student?
  parent            Parent?
  staff             Staff?
  staffModuleAccess StaffModuleAccess[]

  // rows this user acted on (FKs below; kept in sync by the service layer)
  markedAttendances     Attendance[]
  assessedCompetencies  CompetencyAssessment[]
  grantedModuleAccess   StaffModuleAccess[]    @relation("ModuleAccessGranter")
  recordedPayments      Payment[]
  approvedLeaveRequests LeaveRequest[]
  processedPayrollRuns  PayrollRun[]
  initiatedResignations ResignationRecord[]    @relation("ResignationInitiatedBy")
  reviewedResignations  ResignationRecord[]    @relation("ResignationReviewedBy")

  @@index([schoolId])
  @@map("users")
}

// ------------------------------------------------------------
// PEOPLE PROFILES
// ------------------------------------------------------------

// Registry that guarantees employee numbers are unique across BOTH
// teachers and staff within a school. One row is created per employee,
// and Teacher/Staff.employeeKey references it. Employee creation is done
// in a transaction.
model EmployeeNumber {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  employeeNo String
  // "T:<teacherId>" or "S:<staffId>" — which profile owns this number
  ownerKey   String @unique

  teacher Teacher? @relation("EmployeeNumberTeacher")
  staff   Staff?   @relation("EmployeeNumberStaff")

  @@unique([schoolId, employeeNo])
  @@map("employee_numbers")
}

model Teacher {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])

  employeeKey String         @unique
  employeeNo  EmployeeNumber @relation("EmployeeNumberTeacher", fields: [employeeKey], references: [ownerKey])

  nssfNumber String? @unique
  kraPin     String? @unique
  shaNumber  String? @unique

  jobGroupId String?
  jobGroup   JobGroup? @relation(fields: [jobGroupId], references: [id])

  firstName String
  lastName  String
  hireDate  DateTime
  createdAt DateTime @default(now())

  subjects            TeacherSubject[]
  classSubjects       ClassSubject[]
  salaryStructures    SalaryStructure[]
  payslips            Payslip[]
  employmentContracts EmploymentContract[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  customDeductions    CustomDeduction[]
  bankAccounts        BankAccount[]
  employeeSalaryLoans EmployeeSalaryLoan[]
  loanRequests        EmployeeLoanRequest[]
  resignationRecords  ResignationRecord[]

  @@index([schoolId])
  @@map("teachers")
}

model Staff {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])

  employeeKey String         @unique
  employeeNo  EmployeeNumber @relation("EmployeeNumberStaff", fields: [employeeKey], references: [ownerKey])

  nssfNumber String? @unique
  kraPin     String? @unique
  shaNumber  String? @unique

  jobGroupId String?
  jobGroup   JobGroup? @relation(fields: [jobGroupId], references: [id])

  firstName  String
  lastName   String
  department String
  jobTitle   String
  hireDate   DateTime

  salaryStructures    SalaryStructure[]
  payslips            Payslip[]
  employmentContracts EmploymentContract[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  customDeductions    CustomDeduction[]
  bankAccounts        BankAccount[]
  employeeSalaryLoans EmployeeSalaryLoan[]
  loanRequests        EmployeeLoanRequest[]
  resignationRecords  ResignationRecord[]

  @@index([schoolId])
  @@map("staff")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Student {
  id       String  @id @default(uuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id])

  admissionNo   String
  firstName     String
  lastName      String
  dateOfBirth   DateTime @db.Date
  gender        Gender
  admissionDate DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  parents               StudentParent[]
  enrollments           Enrollment[]
  attendances           Attendance[]
  examResults           ExamResult[]
  competencyAssessments CompetencyAssessment[]
  invoices              Invoice[]
  payments              Payment[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@map("students")
}

enum ParentRelation {
  MOTHER
  FATHER
  GUARDIAN
}

model Parent {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])

  firstName String
  lastName  String
  phone     String
  relation  ParentRelation

  students StudentParent[]

  @@index([schoolId])
  @@map("parents")
}

// many-to-many: a student can have multiple parents/guardians on file
model StudentParent {
  studentId String
  parentId  String
  student   Student @relation(fields: [studentId], references: [id])
  parent    Parent  @relation(fields: [parentId], references: [id])

  @@id([studentId, parentId])
  @@map("student_parents")
}

// ------------------------------------------------------------
// ACADEMIC STRUCTURE
// ------------------------------------------------------------

model AcademicYear {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name      String // "2026"
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  // exactly one isCurrent per school is enforced DB-side:
  // partial unique index in migrations/manual_constraints.sql
  isCurrent Boolean  @default(false)

  terms       Term[]
  enrollments Enrollment[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academic_years")
}

model Term {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name           String // "Term 1"
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date

  exams                 Exam[]
  feeStructures         FeeStructure[]
  invoices              Invoice[]
  competencyAssessments CompetencyAssessment[]

  @@unique([academicYearId, name])
  @@index([schoolId])
  @@map("terms")
}

enum Curriculum {
  KCSE // 8-4-4 / Kenyan national scored exams
  CBC // Competency-Based Curriculum — rubric levels, no numeric score
  CAMBRIDGE // IGCSE / A-Level
  IB
}

model ClassLevel {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name          String // "Grade 7", "Form 2", "IGCSE Year 10"
  curriculum    Curriculum     @default(KCSE)
  streams       Stream[]
  feeStructures FeeStructure[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("class_levels")
}

model Stream {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name         String // "East", "Blue"
  classLevelId String
  classLevel   ClassLevel @relation(fields: [classLevelId], references: [id])

  enrollments    Enrollment[]
  classSubjects  ClassSubject[]
  timetableSlots TimetableSlot[]

  @@unique([classLevelId, name])
  @@index([schoolId])
  @@map("streams")
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  WITHDRAWN
}

// A student's placement in a stream for a given academic year
model Enrollment {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  studentId      String
  student        Student          @relation(fields: [studentId], references: [id])
  streamId       String
  stream         Stream           @relation(fields: [streamId], references: [id])
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  enrolledAt     DateTime         @default(now())
  status         EnrollmentStatus @default(ACTIVE)

  attendances           Attendance[]
  examResults           ExamResult[]
  competencyAssessments CompetencyAssessment[]
  invoices              Invoice[]

  @@unique([studentId, academicYearId])
  @@index([schoolId])
  @@map("enrollments")
}

// ------------------------------------------------------------
// SUBJECTS & TEACHING ASSIGNMENTS
// ------------------------------------------------------------

model Subject {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name       String
  code       String
  curriculum Curriculum @default(KCSE)

  teacherSubjects TeacherSubject[]
  classSubjects   ClassSubject[]
  exams           Exam[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("subjects")
}

model TeacherSubject {
  teacherId String
  subjectId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@id([teacherId, subjectId])
  @@map("teacher_subjects")
}

// which teacher teaches which subject to which stream.
// The service layer must validate: stream.classLevel.curriculum ===
// subject.curriculum.
model ClassSubject {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  streamId  String
  stream    Stream  @relation(fields: [streamId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  timetableSlots TimetableSlot[]

  @@unique([streamId, subjectId])
  @@index([schoolId])
  @@map("class_subjects")
}

// ------------------------------------------------------------
// TIMETABLE
// ------------------------------------------------------------

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

// Overlap protection (same stream / same teacher double-booked) is NOT
// in this file — Prisma cannot express exclusion constraints. It lives
// in migrations/manual_constraints.sql: generated columns day_int /
// start_minute / end_minute / teacher_id + two GiST exclusion
// constraints. Room conflicts still need a Room model (TODO).
model TimetableSlot {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  streamId       String
  stream         Stream       @relation(fields: [streamId], references: [id])
  classSubjectId String
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id])
  day            Weekday
  startTime      DateTime     @db.Time // time-of-day only, e.g. 08:00
  endTime        DateTime     @db.Time // service layer must enforce endTime > startTime
  room           String?

  @@index([schoolId])
  @@map("timetable_slots")
}

// ------------------------------------------------------------
// ATTENDANCE
// ------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  studentId    String
  student      Student          @relation(fields: [studentId], references: [id])
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id])
  date         DateTime         @db.Date
  status       AttendanceStatus
  markedById   String
  markedBy     User             @relation(fields: [markedById], references: [id])
  createdAt    DateTime         @default(now())

  @@unique([studentId, date])
  @@index([schoolId])
  @@index([enrollmentId, date]) // hottest report query: per-student history
  @@map("attendance")
}

// ------------------------------------------------------------
// EXAMS & GRADES — scored curricula (KCSE, Cambridge, IB)
// ------------------------------------------------------------

model Exam {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name      String // "Mid-Term CAT", "End Term Exam"
  termId    String
  term      Term     @relation(fields: [termId], references: [id])
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  examDate  DateTime @db.Date
  maxScore  Decimal  @default(100) @db.Decimal(7, 2)

  results ExamResult[]

  @@unique([termId, subjectId, name]) // no duplicate exams for the same term+subject
  @@index([schoolId])
  @@map("exams")
}

model ExamResult {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  examId       String
  exam         Exam       @relation(fields: [examId], references: [id])
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  score        Decimal    @db.Decimal(7, 2)
  grade        String? // computed per curriculum's scale (see GradeScale TODO)
  remarks      String?

  // score <= exam.maxScore is cross-table — enforce in the service layer
  @@unique([examId, studentId])
  @@index([schoolId])
  @@map("exam_results")
}

// ------------------------------------------------------------
// CBC — COMPETENCY-BASED ASSESSMENT
// ------------------------------------------------------------

model LearningArea {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name String // "Mathematics", "Environmental Activities"

  strands Strand[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("learning_areas")
}

model Strand {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  learningAreaId String
  learningArea   LearningArea @relation(fields: [learningAreaId], references: [id])

  name       String
  subStrands SubStrand[]

  @@index([schoolId])
  @@map("strands")
}

model SubStrand {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  strandId String
  strand   Strand @relation(fields: [strandId], references: [id])

  name        String
  assessments CompetencyAssessment[]

  @@index([schoolId])
  @@map("sub_strands")
}

enum CompetencyLevel {
  EXCEEDING_EXPECTATION
  MEETING_EXPECTATION
  APPROACHING_EXPECTATION
  BELOW_EXPECTATION
}

// Deliberately NO unique on (studentId, subStrandId, termId): teachers
// re-assess and correct ratings within a term. Latest-wins is a query
// concern — fetch ordered by assessedAt desc and take the first row.
model CompetencyAssessment {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  subStrandId  String
  subStrand    SubStrand  @relation(fields: [subStrandId], references: [id])
  termId       String
  term         Term       @relation(fields: [termId], references: [id])

  level        CompetencyLevel
  remarks      String?
  assessedById String
  assessedBy   User            @relation(fields: [assessedById], references: [id])
  assessedAt   DateTime        @default(now())
  createdAt    DateTime        @default(now())

  @@index([studentId, subStrandId, termId, assessedAt(sort: Desc)])
  @@index([schoolId])
  @@map("competency_assessments")
}

// ------------------------------------------------------------
// FEES & BILLING (M-Pesa)
// ------------------------------------------------------------

model FeeStructure {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  termId       String
  term         Term       @relation(fields: [termId], references: [id])
  classLevelId String
  classLevel   ClassLevel @relation(fields: [classLevelId], references: [id])
  amount       Decimal    @db.Decimal(12, 2)
  description  String?

  @@unique([termId, classLevelId])
  @@index([schoolId])
  @@map("fee_structures")
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model Invoice {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  studentId    String
  student      Student       @relation(fields: [studentId], references: [id])
  enrollmentId String
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id])
  termId       String
  term         Term          @relation(fields: [termId], references: [id])
  amountDue    Decimal       @db.Decimal(12, 2)
  // TODO: derive from sum(payments) instead of storing — will drift.
  // Kept for now; reconcile in the payments service.
  amountPaid   Decimal       @default(0) @db.Decimal(12, 2)
  status       InvoiceStatus @default(UNPAID)
  dueDate      DateTime      @db.Date
  createdAt    DateTime      @default(now())

  payments Payment[]

  @@unique([studentId, termId])
  @@index([schoolId])
  @@index([status, dueDate]) // overdue/dunning lists
  @@map("invoices")
}

enum PaymentMethod {
  MPESA
  CASH
  CHEQUE
  BANK_DEPOSIT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model Payment {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  // Optional: a C2B paybill payment may arrive with no matching open invoice
  // (paid in advance, overpaid, or a typo'd account number) — it's still
  // recorded, flagged requiresAllocation for a bursar to manually allocate.
  invoiceId String?
  invoice   Invoice?      @relation(fields: [invoiceId], references: [id])
  studentId String?
  student   Student?      @relation(fields: [studentId], references: [id])
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)

  requiresAllocation Boolean   @default(false)
  allocatedAt        DateTime?

  // M-Pesa specific
  mpesaReceipt      String? @unique // filled in once Safaricom callback confirms
  mpesaPhone        String?
  checkoutRequestId String? @unique // returned by STK push, used to match the callback

  // Manual entries (cheque / bank deposit / cash) specific
  reference    String? // cheque number or bank deposit slip/txn ref
  recordedById String? // bursar who recorded it
  recordedBy   User?   @relation(fields: [recordedById], references: [id])
  notes        String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([schoolId, status])
  @@index([schoolId, requiresAllocation]) // bursar's allocation queue
  @@map("payments")
}

// ------------------------------------------------------------
// STAFF MODULE ACCESS
// ------------------------------------------------------------

// Adjust the variants to match your actual module folder names —
// this enum replaces the free-text `module` column so a typo can no
// longer silently grant access to nothing.
enum StaffModule {
  STUDENTS
  ATTENDANCE
  TIMETABLE
  EXAMS
  CBC
  FEES
  REPORTS
}

model StaffModuleAccess {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  userId String
  user   User        @relation(fields: [userId], references: [id])
  module StaffModule

  grantedById String
  grantedBy   User     @relation("ModuleAccessGranter", fields: [grantedById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([userId, module])
  @@index([schoolId])
  @@map("staff_module_access")
}

// ------------------------------------------------------------
// AUDIT TRAIL
// ------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id       String  @id @default(uuid())
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  actorId    String // User.id — intentionally a loose string: the audit
  entityType String // trail must survive user deletion
  entityId   String
  action     AuditAction
  createdAt  DateTime    @default(now())

  @@index([schoolId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model FileUpload {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  fileName      String
  originalName  String
  mimeType      String
  sizeBytes     Int
  storageKey    String
  storageBucket String
  url           String?
  relatedType   String?
  relatedId     String?
  uploadedById  String?
  createdAt     DateTime @default(now())

  @@index([relatedType, relatedId])
  @@map("file_uploads")
}

// ------------------------------------------------------------
// PAYROLL & HR
// ------------------------------------------------------------

enum AllowanceApplicability {
  ALL_EMPLOYEES
  TEACHERS
  STAFF
  JOB_GROUP
}

model JobGroup {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  teachers       Teacher[]
  staff          Staff[]
  allowanceTypes AllowanceType[]

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("job_groups")
}

model BankAccount {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id])

  bankName              String
  branchName            String?
  accountHolderName     String
  accountNumber         String
  iban                  String?
  swiftCode             String?
  routingNumber         String?
  currency              String   @default("KES")
  isPrimary             Boolean  @default(false)
  supportsWireTransfer  Boolean  @default(true)
  supportsBankTransfer  Boolean  @default(true)
  isVerified            Boolean  @default(false)
  verificationReference String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([teacherId, accountNumber])
  @@unique([staffId, accountNumber])
  @@index([schoolId])
  @@map("bank_accounts")
}

enum LoanStatus {
  ACTIVE
  PARTIALLY_PAID
  COMPLETED
  DEFAULTED
}

enum LoanRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LoanSourceType {
  SCHOOL
  BANK
  SACCO
  OTHER
}

model LoanProvider {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name        String
  type        LoanSourceType @default(BANK)
  contactName String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  loans EmployeeSalaryLoan[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("loan_providers")
}

model EmployeeLoanRequest {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id])

  requestType      LoanSourceType    @default(SCHOOL)
  title            String
  amount           Decimal           @db.Decimal(12, 2)
  reason           String?
  purpose          String?
  requestedAt      DateTime          @default(now())
  neededByDate     DateTime?         @db.Date
  status           LoanRequestStatus @default(PENDING)
  approvedAmount   Decimal?          @db.Decimal(12, 2)
  approvalNotes    String?
  rejectionReason  String?
  attachmentId     String?
  attachmentUrl    String?
  approvedByUserId String?
  approvedAt       DateTime?

  loan EmployeeSalaryLoan?

  @@index([schoolId, status])
  @@index([schoolId, teacherId])
  @@index([schoolId, staffId])
  @@map("employee_loan_requests")
}

model EmployeeSalaryLoan {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id])

  requestId String?              @unique
  request   EmployeeLoanRequest? @relation(fields: [requestId], references: [id])

  providerId String?
  provider   LoanProvider? @relation(fields: [providerId], references: [id])

  title            String
  loanType         String // SALARY_ADVANCE, BANK_LOAN, SACCO_LOAN, EMERGENCY_LOAN
  amount           Decimal        @db.Decimal(12, 2)
  balance          Decimal        @db.Decimal(12, 2)
  monthlyDeduction Decimal        @db.Decimal(12, 2)
  interestRate     Decimal?       @db.Decimal(5, 2)
  sourceType       LoanSourceType @default(SCHOOL)
  accountNumber    String?
  referenceNumber  String?
  reason           String?
  attachmentId     String?
  attachmentUrl    String?
  startDate        DateTime       @db.Date
  dueDate          DateTime?      @db.Date
  status           LoanStatus     @default(ACTIVE)
  isApproved       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  repayments LoanRepayment[]

  @@index([schoolId, status])
  @@index([schoolId, teacherId])
  @@index([schoolId, staffId])
  @@map("employee_salary_loans")
}

// Additional DB-side validation is kept in a migration for PostgreSQL:
// CHECK ((source_type IN ('SCHOOL', 'OTHER') AND "providerId" IS NULL)
//     OR (source_type IN ('BANK', 'SACCO') AND "providerId" IS NOT NULL))

model LoanRepayment {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  loanId String
  loan   EmployeeSalaryLoan @relation(fields: [loanId], references: [id])

  amount        Decimal  @db.Decimal(12, 2)
  paymentDate   DateTime @db.Date
  paymentMethod String? // BANK_TRANSFER, MPESA, CASH, PAYROLL_DEDUCTION
  reference     String?
  notes         String?
  attachmentId  String?
  attachmentUrl String?
  createdAt     DateTime @default(now())

  @@index([loanId, paymentDate])
  @@index([schoolId, paymentDate])
  @@map("loan_repayments")
}

model AllowanceType {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name          String
  code          String
  description   String?
  applicability AllowanceApplicability @default(ALL_EMPLOYEES)
  jobGroupId    String?
  jobGroup      JobGroup?              @relation(fields: [jobGroupId], references: [id])
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())

  salaryStructures SalaryStructure[]

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("allowance_types")
}

model StatutoryDeduction {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  salaryStructures SalaryStructure[]

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("statutory_deductions")
}

model SalaryStructure {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id])

  allowanceTypeId String?
  allowanceType   AllowanceType? @relation(fields: [allowanceTypeId], references: [id])

  statutoryDeductionId String?
  statutoryDeduction   StatutoryDeduction? @relation(fields: [statutoryDeductionId], references: [id])

  basicSalary        Decimal @db.Decimal(12, 2)
  houseAllowance     Decimal @default(0) @db.Decimal(12, 2)
  transportAllowance Decimal @default(0) @db.Decimal(12, 2)

  // Per-employee statutory exemptions
  exemptPaye        Boolean @default(false)
  exemptNssf        Boolean @default(false)
  exemptShif        Boolean @default(false)
  exemptHousingLevy Boolean @default(false)

  // exactly one isActive per employee is enforced DB-side (partial
  // unique indexes in migrations/manual_constraints.sql)
  effectiveDate DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  payslips Payslip[]

  @@index([schoolId])
  @@map("salary_structures")
}

model StatutoryRateConfig {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  payeMonthlyRelief Decimal @db.Decimal(12, 2)
  payeBands         Json // [{ upTo: number|null, rate: number }, ...]

  nssfTierILimit  Decimal @db.Decimal(12, 2)
  nssfTierIILimit Decimal @db.Decimal(12, 2)
  nssfRate        Float // percentage, e.g. 0.06

  shifRate    Float // percentage
  shifMinimum Decimal @db.Decimal(12, 2)

  housingLevyRate Float // percentage

  effectiveDate DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([schoolId])
  @@map("statutory_rate_configs")
}

model CustomDeduction {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id])

  name        String
  amount      Decimal @db.Decimal(12, 2)
  isRecurring Boolean @default(true)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@map("custom_deductions")
}

enum PayrollRunStatus {
  DRAFT
  PROCESSED
  PAID
}

model PayrollRun {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  // "YYYY-MM" — format enforced by a CHECK constraint in
  // migrations/manual_constraints.sql
  month  String
  status PayrollRunStatus @default(DRAFT)

  processedById String?
  processedBy   User?     @relation(fields: [processedById], references: [id])
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  payslips Payslip[]

  @@unique([schoolId, month])
  @@index([schoolId])
  @@map("payroll_runs")
}

enum PayslipPaymentMethod {
  BANK
  MPESA
  CASH
}

enum PayslipStatus {
  PENDING
  PAID
}

model Payslip {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  payrollRunId      String
  payrollRun        PayrollRun      @relation(fields: [payrollRunId], references: [id])
  salaryStructureId String
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id])

  // "T:<teacherId>" or "S:<staffId>" — single non-null discriminator so
  // @@unique actually works (Postgres NULLs are distinct)
  employeeKey String

  // Earnings (snapshotted at time of processing)
  basicSalary        Decimal @db.Decimal(12, 2)
  houseAllowance     Decimal @db.Decimal(12, 2)
  transportAllowance Decimal @db.Decimal(12, 2)
  otherAllowances    Decimal @db.Decimal(12, 2)
  grossPay           Decimal @db.Decimal(12, 2)

  // Statutory deductions (employee portion)
  paye            Decimal @db.Decimal(12, 2)
  nssf            Decimal @db.Decimal(12, 2)
  shif            Decimal @db.Decimal(12, 2)
  housingLevy     Decimal @db.Decimal(12, 2)
  otherDeductions Decimal @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal @db.Decimal(12, 2)

  netPay Decimal @db.Decimal(12, 2)

  paymentMethod PayslipPaymentMethod @default(BANK)
  status        PayslipStatus        @default(PENDING)
  paidAt        DateTime?

  createdAt DateTime @default(now())

  @@unique([payrollRunId, employeeKey])
  @@index([schoolId])
  @@map("payslips")
}

enum ContractType {
  PERMANENT
  FIXED_TERM
  INTERNSHIP
  CONSULTANT
}

enum ContractStatus {
  ACTIVE
  TERMINATED
  EXPIRED
}

model EmploymentContract {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id])

  contractType ContractType
  startDate    DateTime       @db.Date
  endDate      DateTime?      @db.Date
  status       ContractStatus @default(ACTIVE)
  documentUrl  String? // storage PATH (bucket is private)
  documentId   String?
  notes        String?

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@map("employment_contracts")
}

model LeaveType {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name               String
  defaultDaysPerYear Int

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("leave_types")
}

model LeaveBalance {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id])

  // single non-null discriminator — replaces the broken
  // @@unique([teacherId, staffId, ...]) whose NULL columns made the
  // constraint unenforceable
  employeeKey String

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int

  daysAllocated Decimal @db.Decimal(5, 2)
  daysUsed      Decimal @default(0) @db.Decimal(5, 2)

  @@unique([employeeKey, leaveTypeId, year])
  @@index([schoolId])
  @@map("leave_balances")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ResignationStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
  COMPLETED
}

model LeaveRequest {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id])

  leaveTypeId     String
  leaveType       LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  daysRequested   Decimal     @db.Decimal(5, 2)
  reason          String?
  status          LeaveStatus @default(PENDING)
  approvedById    String?
  approvedBy      User?       @relation(fields: [approvedById], references: [id])
  rejectionReason String?
  approvalNotes   String?
  attachmentId    String?
  attachmentUrl   String?
  decidedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@map("leave_requests")
}

model ResignationRecord {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id])

  resignationDate DateTime          @db.Date
  noticeDate      DateTime          @db.Date
  reason          String
  details         String?
  status          ResignationStatus @default(PENDING)
  initiatedById   String?
  initiatedBy     User?             @relation("ResignationInitiatedBy", fields: [initiatedById], references: [id])
  reviewedById    String?
  reviewedBy      User?             @relation("ResignationReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  finalExitDate   DateTime?         @db.Date
  handoverNotes   String?
  attachmentId    String?
  attachmentUrl   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, teacherId])
  @@index([schoolId, staffId])
  @@map("resignation_records")
}
